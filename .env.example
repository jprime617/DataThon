# Modelo das variáveis de ambiente do pipeline (R8.5).
# Copie para `.env` e preencha — `.env` está no .gitignore e NUNCA é versionado.
# Depois, exporte no shell:  set -a; source .env; set +a

# Provedor do LLM externo usado no agrupamento de CBOs: "gemini" (padrão) ou
# "anthropic". O Gemini é o caminho gratuito — o Google AI Studio emite a chave
# sem cartão de crédito e a camada gratuita cobre os ~23 lotes desta etapa.
LLM_PROVIDER=gemini

# Credencial da API do LLM externo. Sem ela o pipeline interrompe ANTES de
# chamar a API (R8.6).
#   gemini    → https://aistudio.google.com/apikey  (gratuito, começa com "AIza")
#   anthropic → https://console.anthropic.com → Settings → API Keys ("sk-ant-")
LLM_API_KEY=AIza...

# Connection string completa do Azure Storage Account, obtida no portal em
# Storage account → Security + networking → Access keys → key1 → Connection string.
# Sem ela (ou malformada) a etapa de upload interrompe sem enviar dados (R8.7, R9.3).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Container do Blob Storage onde ficam as tabelas agregadas. O pipeline escreve
# e o dashboard lê deste mesmo container — mantenha o valor idêntico nos dois
# ambientes (local e App Service).
AZURE_BLOB_CONTAINER=caged-agregado
